# Conexión a SQL Server (pyodbc)
# Estos valores por defecto apuntan al contenedor Docker local
# (ver docker-compose.yml + README.md de este directorio).
# En producción, IT reemplaza estos valores por la instancia real —
# no se toca código, solo las variables de entorno del ambiente.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=portafolio_iniciativas_anc
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
# El contenedor Docker local usa un certificado autogenerado, no emitido
# por una autoridad confiable, y el Driver 18 exige validarlo por defecto.
# "yes" evita ese error en desarrollo local. En producción, cuando IT
# provea el certificado real de la instancia, cambiar a "no" para que
# la verificación de certificado se aplique correctamente.
DB_TRUST_SERVER_CERTIFICATE=yes

# Claude API — dejar CLAUDE_STUB_MODE=true hasta que se apruebe presupuesto
CLAUDE_STUB_MODE=true
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# PORT por defecto es 8010 en este equipo, no el 8000 convencional de FastAPI/uvicorn
# — ver "Problemas conocidos" en README.md (reserva fantasma del puerto 8000 en Windows).
PORT=8010
