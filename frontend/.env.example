# Puerto 8010, no el 8000 convencional — ver "Problemas conocidos" en
# v1.0/README.md (reserva fantasma del puerto 8000 en Windows en este equipo).
VITE_API_URL=http://localhost:8010

# Login con Microsoft Entra ID (MSAL) — pendiente de IT (Arnoldo).
# Mientras estén vacías, la app usa el usuario simulado (ver core/UsuarioActualContext.tsx)
# y no se muestra el botón de "Iniciar sesión con Microsoft".
# Ver v1.0/README.md para el detalle de qué se necesita pedir.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
