    op.execute(
        """
        UPDATE revision_ideas
           SET origen_asignacion =
                CASE
                    WHEN revisor_id IS NULL THEN 'sin_asignar'
                    WHEN departamento_sugerido_ia_id IS NOT NULL THEN 'mapeo_area'
                    ELSE 'fallback_departamento_autor'
                END
        """
