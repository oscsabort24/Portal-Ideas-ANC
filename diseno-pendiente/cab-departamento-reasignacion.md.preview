## 3. `comites/router.py` — filtro por departamento + reasignación

```python
def _departamentos_visibles(db: Session, usuario: Usuario) -> list[int] | None:
    """None = ve todos los departamentos (admin, o miembro de CAB sin
    filas en miembros_cab_departamentos — ausencia de filas = "todos",
    igual que se diseñó en cab-departamento-y-criterios-ia.md.preview)."""
    if usuario.rol == RolUsuario.admin:
        return None
    membresias = db.query(MiembroCAB).filter_by(usuario_id=usuario.id).all()
    if not membresias:
        return []  # no es miembro de ningún CAB
    ids = {d.departamento_id for m in membresias for d in m.departamentos}
    return list(ids) if ids else None  # sin filas = todos


def _validar_acceso_comite_idea(db: Session, usuario: Usuario, comite: ComiteIdea) -> None:
    if usuario.rol == RolUsuario.admin:
        return
    if not usuario.activo:
        raise HTTPException(status_code=403, detail="Usuario inactivo")
    departamentos = _departamentos_visibles(db, usuario)
    if departamentos is None:
        return
    if comite.idea.autor.departamento_id not in departamentos:
        raise HTTPException(status_code=403, detail="Esta idea no pertenece a un departamento asignado a tu CAB")


@router.get("/cola", response_model=list[schemas.ComiteIdeaDetalleOut])  # antes: /{tipo_cab}/cola
def cola_comite(
    estado: EstadoComite = EstadoComite.pendiente,
    db: Session = Depends(get_db),
    usuario_actual: Usuario = Depends(obtener_usuario_actual),
):
    departamentos = _departamentos_visibles(db, usuario_actual)
    if departamentos == []:
        return []
    query = (
        db.query(ComiteIdea)
        .join(Idea, ComiteIdea.idea_id == Idea.id)
        .join(Usuario, Idea.autor_id == Usuario.id)
        .filter(ComiteIdea.estado == estado)
    )
    if departamentos is not None:
        query = query.filter(Usuario.departamento_id.in_(departamentos))
    return query.order_by(ComiteIdea.creado_en.asc(), ComiteIdea.id.asc()).all()
```

`aprobar`/`rechazar`/`obtener_rice`/`guardar_rice` cambian su llamada de
`_validar_acceso_comite(db, usuario, comite.tipo_cab)` a
`_validar_acceso_comite_idea(db, usuario, comite)` — sin cambios en el
resto de su lógica.

### Nuevos endpoints — reasignación dentro del CAB (mismo patrón que Fase 4)

```python
@router.post("/{idea_id}/reasignar", response_model=schemas.ComiteIdeaOut)
def reasignar(
    idea_id: int,
    payload: schemas.ReasignarComiteRequest,  # {nuevo_asignado_id, motivo?}
    db: Session = Depends(get_db),
    usuario_actual: Usuario = Depends(obtener_usuario_actual),
):
    comite = _obtener_comite(db, idea_id)
    _validar_acceso_comite_idea(db, usuario_actual, comite)
    if comite.estado != EstadoComite.pendiente:
        raise HTTPException(status_code=400, detail="Esta idea no está pendiente en el comité")

    nuevo = _validar_miembro_destino(db, comite, payload.nuevo_asignado_id)  # valida MiembroCABDepartamento del depto de la idea
    db.add(HistorialIdea(idea_id=idea_id, tipo_evento=TipoEventoIdea.reasignacion_solicitada,
                          actor_id=usuario_actual.id, sujeto_id=nuevo.id, detalle=payload.motivo))
    comite.propuesto_a_id = nuevo.id
    comite.reasignacion_solicitada_por_id = usuario_actual.id
    comite.fecha_solicitud_reasignacion = datetime.now(timezone.utc)
    comite.estado = EstadoComite.pendiente_aceptacion_reasignacion
    db.commit()
    db.refresh(comite)
    return comite


@router.post("/{idea_id}/aceptar-reasignacion", response_model=schemas.ComiteIdeaOut)
def aceptar_reasignacion(idea_id: int, db: Session = Depends(get_db),
                          usuario_actual: Usuario = Depends(obtener_usuario_actual)):
    comite = _obtener_comite(db, idea_id)
    if comite.estado != EstadoComite.pendiente_aceptacion_reasignacion:
        raise HTTPException(status_code=400, detail="Esta idea no tiene una reasignación pendiente de respuesta")
    if comite.propuesto_a_id != usuario_actual.id:
        raise HTTPException(status_code=403, detail="No sos la persona propuesta")
    db.add(HistorialIdea(idea_id=idea_id, tipo_evento=TipoEventoIdea.reasignacion_aceptada,
                          actor_id=usuario_actual.id, sujeto_id=usuario_actual.id))
    comite.asignado_a_id = usuario_actual.id
    comite.propuesto_a_id = None
    comite.reasignacion_solicitada_por_id = None
    comite.fecha_solicitud_reasignacion = None
    comite.rechazos_reasignacion_consecutivos = 0
    comite.estado = EstadoComite.pendiente
    db.commit()
    db.refresh(comite)
    return comite


@router.post("/{idea_id}/rechazar-reasignacion", response_model=schemas.ComiteIdeaOut)
def rechazar_reasignacion(idea_id: int, payload: schemas.RechazarReasignacionRequest,
                           db: Session = Depends(get_db),
                           usuario_actual: Usuario = Depends(obtener_usuario_actual)):
    comite = _obtener_comite(db, idea_id)
    if comite.propuesto_a_id != usuario_actual.id:
        raise HTTPException(status_code=403, detail="No sos la persona propuesta")
    aplicar_rechazo_reasignacion(
        db, comite, campo_responsable="asignado_a_id",
        estado_sin_asignar=None,  # ComiteIdea no tiene estado bloqueante equivalente
        estado_normal=EstadoComite.pendiente,
        idea_id=idea_id, actor_id=usuario_actual.id,
        tipo_evento=TipoEventoIdea.reasignacion_rechazada, detalle=payload.motivo,
    )
    db.commit()
    db.refresh(comite)
    return comite
```

`_validar_miembro_destino` valida que el destino tenga `MiembroCABDepartamento`
cubriendo el departamento del autor de esa idea (o sea comodín sin filas) —
mismo criterio de elegibilidad que `_departamentos_visibles`.

