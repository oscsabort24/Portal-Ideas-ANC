## 2. `core/reasignacion.py` — las 2 funciones genéricas

```python
"""Política compartida de reasignación con aceptación/rechazo, usada por
revision/ y comites/ — ver diseno-pendiente/cab-departamento-reasignacion.md.preview.

Generalizado desde el diseño original de Fase 4 (pensado solo para
RevisionIdea): las funciones reciben el modelo, el nombre del campo
"responsable actual", y los valores de estado a usar, en vez de tener
RevisionIdea/EstadoRevision hardcodeados.
"""

from datetime import datetime, timedelta, timezone
from typing import Any

from sqlalchemy.orm import Session

from ideas.models import HistorialIdea, TipoEventoIdea

DIAS_HABILES_ACEPTACION_REASIGNACION = 3
MAX_RECHAZOS_CONSECUTIVOS = 2


def sumar_dias_habiles(desde: datetime, dias: int) -> datetime:
    resultado = desde
    restantes = dias
    while restantes > 0:
        resultado += timedelta(days=1)
        if resultado.weekday() < 5:
            restantes -= 1
    return resultado


def aplicar_rechazo_reasignacion(
    db: Session,
    entidad: Any,
    *,
    campo_responsable: str,  # "revisor_id" o "asignado_a_id"
    estado_sin_asignar,  # EstadoRevision.pendiente_asignacion o None (ver nota)
    estado_normal,  # EstadoRevision.pendiente_revision o EstadoComite.pendiente
    idea_id: int,
    actor_id: int,
    tipo_evento: TipoEventoIdea,
    detalle: str | None = None,
) -> None:
    """Política única de rechazo — compartida por rechazo explícito y expiración.

    Primer rechazo: vuelve al estado normal, el responsable actual no cambia
    (nunca se movió mientras la propuesta estaba pendiente). Segundo rechazo
    consecutivo: se limpia el responsable (si estado_sin_asignar existe) para
    que un admin decida, o simplemente vuelve a "sin asignado específico"
    (ComiteIdea, donde no hay un estado bloqueante equivalente — ver 1.2).
    """
    db.add(
        HistorialIdea(
            idea_id=idea_id,
            tipo_evento=tipo_evento,
            actor_id=actor_id,
            sujeto_id=getattr(entidad, "propuesto_a_id"),
            detalle=detalle,
        )
    )

    entidad.rechazos_reasignacion_consecutivos += 1
    entidad.propuesto_a_id = None
    entidad.reasignacion_solicitada_por_id = None
    entidad.fecha_solicitud_reasignacion = None

    if entidad.rechazos_reasignacion_consecutivos >= MAX_RECHAZOS_CONSECUTIVOS:
        if estado_sin_asignar is not None:
            setattr(entidad, campo_responsable, None)
            entidad.estado = estado_sin_asignar
        else:
            # ComiteIdea: no existe un estado "sin asignar" bloqueante —
            # simplemente se limpia asignado_a_id y vuelve a pendiente,
            # visible a cualquier miembro del departamento otra vez.
            setattr(entidad, campo_responsable, None)
            entidad.estado = estado_normal
    else:
        entidad.estado = estado_normal


def expirar_reasignaciones_vencidas(
    db: Session,
    modelo,
    *,
    estado_pendiente_aceptacion,
    campo_responsable: str,
    estado_sin_asignar,
    estado_normal,
    tipo_evento_expirada: TipoEventoIdea,
) -> list:
    ahora = datetime.now(timezone.utc)
    pendientes = (
        db.query(modelo)
        .filter(
            modelo.estado == estado_pendiente_aceptacion,
            modelo.fecha_solicitud_reasignacion.isnot(None),
        )
        .all()
    )

    expiradas = []
    for entidad in pendientes:
        limite = sumar_dias_habiles(entidad.fecha_solicitud_reasignacion, DIAS_HABILES_ACEPTACION_REASIGNACION)
        if ahora < limite:
            continue
        aplicar_rechazo_reasignacion(
            db,
            entidad,
            campo_responsable=campo_responsable,
            estado_sin_asignar=estado_sin_asignar,
            estado_normal=estado_normal,
            idea_id=entidad.idea_id,
            actor_id=entidad.reasignacion_solicitada_por_id or getattr(entidad, campo_responsable),
            tipo_evento=tipo_evento_expirada,
            detalle=f"Sin respuesta en {DIAS_HABILES_ACEPTACION_REASIGNACION} días hábiles",
        )
        expiradas.append(entidad)
    return expiradas
```

`revision/service.py` y `comites/service.py` (nuevo, ver 4) llaman estas
2 funciones con sus propios parámetros — la política (2 rechazos → pool,
3 días hábiles) queda escrita una sola vez.

