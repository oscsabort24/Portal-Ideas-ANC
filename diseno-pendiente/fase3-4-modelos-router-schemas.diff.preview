+class OrigenAsignacion(str, enum.Enum):
+    """De dónde salió el revisor actual de una revisión.
+
+    Hasta ahora esto se infería leyendo tres columnas nullables
+    (departamento_sugerido_ia_id, justificacion_ia, acepto_sugerencia_autor)
+    y sabiendo de memoria qué combinación significaba qué. Con la tabla de
+    mapeo determinístico (usuarios.models:ResponsableArea) hay más caminos
+    posibles, así que el origen se guarda explícito.
+    """
+
+    # La IA eligió el área y ResponsableArea resolvió la persona.
+    mapeo_area = "mapeo_area"
+    # No hubo área utilizable (la IA falló, o el área que sugirió no tiene
+    # responsable): se cayó al departamento del autor.
+    fallback_departamento_autor = "fallback_departamento_autor"
+    # Un admin la asignó o reasignó a mano.
+    manual = "manual"
+    # No se pudo resolver a nadie; espera asignación de un admin.
+    sin_asignar = "sin_asignar"
 
 
