-        db.query(Usuario)
+def _buscar_encargado_activo(db: Session, departamento_id: int, autor: Usuario) -> Usuario | None:
+    """Resuelve el responsable de un área contra ResponsableArea.
+
+    Determinístico: el orden es explícito (prioridad ascendente, con id como
+    desempate final para que dos filas mal configuradas con la misma
+    prioridad tampoco produzcan un resultado que cambie entre ejecuciones).
+    Antes esto era un `.first()` sin ORDER BY, que en SQL Server devuelve
+    una fila arbitraria.
+
+    Se consideran solo las filas activas, dentro de su ventana de vigencia,
+    cuyo usuario siga activo y con rol habilitado para revisar, y cuyo
+    pais/compania sea NULL (comodín) o coincida con los del AUTOR.
+    """
+    ahora = datetime.now(timezone.utc)
+
+    fila = (
+        db.query(ResponsableArea)
+        .join(Usuario, ResponsableArea.usuario_id == Usuario.id)
         .filter(
-            Usuario.departamento_id == departamento_id,
-            Usuario.rol.in_(ROLES_HABILITADOS_REVISOR),
+            ResponsableArea.departamento_id == departamento_id,
+            ResponsableArea.activo == True,  # noqa: E712
+            or_(ResponsableArea.vigente_desde.is_(None), ResponsableArea.vigente_desde <= ahora),
+            or_(ResponsableArea.vigente_hasta.is_(None), ResponsableArea.vigente_hasta >= ahora),
+            or_(ResponsableArea.pais.is_(None), ResponsableArea.pais == autor.pais),
+            or_(ResponsableArea.compania.is_(None), ResponsableArea.compania == autor.compania),
+            # El mapeo no puede resucitar a alguien dado de baja ni a quien
+            # perdió el rol de revisor — se valida contra el usuario real.
             Usuario.activo == True,  # noqa: E712
+            Usuario.rol.in_(ROLES_HABILITADOS_REVISOR),
         )
+        .order_by(ResponsableArea.prioridad.asc(), ResponsableArea.id.asc())
         .first()
     )
+    return fila.usuario if fila is not None else None
 
 
