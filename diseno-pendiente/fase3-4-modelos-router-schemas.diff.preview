+class ResponsableArea(Base):
+    """Mapeo determinístico área -> persona responsable de revisar.
+
+    Reemplaza la parte NO determinística de la asignación automática. La IA
+    sigue eligiendo el ÁREA (revision/service.py:_asignar_por_ia devuelve un
+    nombre de departamento, nunca una persona), pero hasta ahora la persona
+    salía de un `.first()` sin ORDER BY sobre todos los usuarios activos del
+    departamento con rol habilitado — en SQL Server, sin orden explícito, qué
+    fila sale es indeterminado y puede cambiar entre ejecuciones. Con esta
+    tabla la resolución es una consulta ordenada y auditable.
+
+    RESOLUCIÓN (ver revision/service.py:_buscar_encargado_activo):
+    se filtran las filas activas y vigentes del departamento, se descartan
+    las que declaran un `pais`/`compania` distinto al del AUTOR de la idea,
+    y de las que quedan se toma la de menor `prioridad`. Una fila con
+    pais=NULL y compania=NULL es el comodín "aplica a todos" y actúa como
+    respaldo natural de las específicas, porque las específicas se declaran
+    con prioridad más baja (1) que el comodín (ej. 10).
+
+    Ejemplo — Tecnología:
+        (Tecnología, Ana,  prioridad=1, pais=GT,   compania=NULL)
+        (Tecnología, Luis, prioridad=2, pais=GT,   compania=NULL)  suplente GT
+        (Tecnología, Beto, prioridad=10, pais=NULL, compania=NULL) comodín
+    Una idea de un autor de GT resuelve Ana; si Ana está inactiva o fuera de
+    vigencia, Luis; una idea de CR resuelve Beto.
+
+    NO reemplaza el fallback final de "mismo departamento del autor": si el
+    área que sugirió la IA no tiene ninguna fila utilizable, se sigue
+    intentando el departamento del autor, y si tampoco, la revisión nace en
+    pendiente_asignacion para que un admin la resuelva a mano.
+    """
+
+    __tablename__ = "responsables_area"
+    __table_args__ = (
+        UniqueConstraint(
+            "departamento_id",
+            "pais",
+            "compania",
+            "prioridad",
+            name="uq_responsable_area_depto_pais_compania_prioridad",
+        ),
+    )
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True)
+    departamento_id: Mapped[int] = mapped_column(ForeignKey("departamentos.id"), nullable=False)
+    usuario_id: Mapped[int] = mapped_column(ForeignKey("usuarios.id"), nullable=False)
+
+    # 1 = titular, 2 = suplente, y así. Es el criterio de desempate que
+    # elimina el .first() arbitrario: menor número gana.
+    prioridad: Mapped[int] = mapped_column(Integer, nullable=False)
+
+    # NULL = "aplica a cualquier país / cualquier compañía". Se comparan
+    # contra el país y la compañía del AUTOR de la idea, no del revisor.
+    pais: Mapped[PaisUsuario | None] = mapped_column(
+        Enum(PaisUsuario, name="pais_responsable_area"), nullable=True
+    )
+    compania: Mapped[CompaniaUsuario | None] = mapped_column(
+        Enum(CompaniaUsuario, name="compania_responsable_area"), nullable=True
+    )
+
+    activo: Mapped[bool] = mapped_column(Boolean, default=True, nullable=False)
+
+    # Ventana de vigencia opcional (vacaciones, interinatos, rotación).
+    # NULL en cualquiera de los dos extremos = sin límite por ese lado.
+    vigente_desde: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    vigente_hasta: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+
+    departamento: Mapped["Departamento"] = relationship()
+    usuario: Mapped["Usuario"] = relationship()
