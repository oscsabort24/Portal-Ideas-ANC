+# Plazo para que la persona propuesta acepte o rechace. Al vencer se aplica
+# sola la política de rechazo (ver aplicar_rechazo_reasignacion). Son días
+# HÁBILES: 3 días corridos que caen jueves-domingo darían menos de un día
+# laboral real de margen.
+DIAS_HABILES_ACEPTACION_REASIGNACION = 3
+
+# Al segundo rechazo consecutivo la revisión deja de rebotar entre personas
+# y cae al pool del admin.
+MAX_RECHAZOS_CONSECUTIVOS = 2
+
+
+def sumar_dias_habiles(desde: datetime, dias: int) -> datetime:
+    """Suma días hábiles (lunes a viernes). No contempla feriados: no hay
+    calendario de feriados en el sistema todavía, y meterlo por este caso
+    sería inventar una fuente de verdad que después habría que mantener
+    para los 4 países. Si algún día existe, este es el único punto a tocar."""
+    resultado = desde
+    restantes = dias
+    while restantes > 0:
+        resultado += timedelta(days=1)
+        if resultado.weekday() < 5:
+            restantes -= 1
+    return resultado
+
+
+def aplicar_rechazo_reasignacion(
+    db: Session,
+    revision: RevisionIdea,
+    actor_id: int,
+    tipo_evento: TipoEventoIdea,
+    detalle: str | None = None,
+) -> RevisionIdea:
+    """Política única de rechazo, compartida por el rechazo explícito y por
+    la expiración del plazo — así ambos caminos no pueden divergir.
+
+    Primer rechazo: la revisión vuelve a quien la reasignó. En la práctica
+    "volver" es no hacer nada con revisor_id, que nunca se movió: solo se
+    limpia la propuesta y se regresa a pendiente_revision.
+
+    Segundo rechazo consecutivo: se suelta al pool (pendiente_asignacion,
+    revisor_id = NULL) para que un admin decida. Evita que dos personas se
+    devuelvan la misma idea sin fin.
+    """
+    db.add(
+        HistorialIdea(
+            idea_id=revision.idea_id,
+            tipo_evento=tipo_evento,
+            actor_id=actor_id,
+            sujeto_id=revision.revisor_propuesto_id,
+            detalle=detalle,
+        )
+    )
+
+    revision.rechazos_reasignacion_consecutivos += 1
+    revision.revisor_propuesto_id = None
+    revision.reasignacion_solicitada_por_id = None
+    revision.fecha_solicitud_reasignacion = None
+
+    if revision.rechazos_reasignacion_consecutivos >= MAX_RECHAZOS_CONSECUTIVOS:
+        revision.revisor_id = None
+        revision.estado = EstadoRevision.pendiente_asignacion
+        revision.origen_asignacion = OrigenAsignacion.sin_asignar
+    else:
+        revision.estado = EstadoRevision.pendiente_revision
+
+    return revision
+
+
+def expirar_reasignaciones_vencidas(db: Session) -> list[RevisionIdea]:
+    """Aplica la política de rechazo a toda propuesta que pasó el plazo.
+
+    Sin esto una propuesta que nadie responde congela la idea para siempre:
+    el revisor original ya no la ve como accionable y el propuesto nunca
+    contesta.
+
+    Se dispara desde POST /revision/expirar-reasignaciones, del mismo modo
+    que POST /notificaciones/revisar dispara el escalamiento por plazo. No
+    reutiliza ConfiguracionEscalamiento: esa tabla configura un plazo por
+    ETAPA del flujo (revision/clasificacion/comites) con un responsable a
+    quien avisar, que es otro concepto — acá el plazo es de una propuesta
+    concreta y al vencer no se avisa a nadie, se resuelve sola. Meterlo ahí
+    obligaría a que `etapa` dejara de ser único.
+
+    El actor del evento es quien pidió la reasignación: nadie "ejecutó" la
+    expiración, y atribuírsela a quien no respondió sugeriría un rechazo
+    explícito que no ocurrió.
+    """
+    ahora = datetime.now(timezone.utc)
+    pendientes = (
+        db.query(RevisionIdea)
+        .filter(
+            RevisionIdea.estado == EstadoRevision.pendiente_aceptacion_reasignacion,
+            RevisionIdea.fecha_solicitud_reasignacion.isnot(None),
+        )
+        .all()
+    )
+
+    expiradas = []
+    for revision in pendientes:
+        limite = sumar_dias_habiles(
+            revision.fecha_solicitud_reasignacion, DIAS_HABILES_ACEPTACION_REASIGNACION
+        )
+        if ahora < limite:
+            continue
+        aplicar_rechazo_reasignacion(
+            db,
+            revision,
+            actor_id=revision.reasignacion_solicitada_por_id or revision.revisor_id,
+            tipo_evento=TipoEventoIdea.reasignacion_expirada,
+            detalle=f"Sin respuesta en {DIAS_HABILES_ACEPTACION_REASIGNACION} días hábiles",
+        )
+        expiradas.append(revision)
+
+    return expiradas
+
+
