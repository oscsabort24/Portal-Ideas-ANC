+class TipoEventoIdea(str, enum.Enum):
+    """Tipos de evento de HistorialIdea.
+
+    Arranca cubriendo solo el ciclo de reasignación con aceptación, que es
+    lo que no tiene registro hoy. El enum está pensado para crecer y
+    absorber después los eventos que GET /ideas/{id}/linea-tiempo deriva
+    hoy de varias tablas (aprobada, cambios_solicitados, clasificada,
+    resuelta_en_comite...), hasta que la línea de tiempo se lea de una sola
+    tabla en vez de reconstruirse con joins.
+
+    Agregar un valor nuevo requiere migración: en SQL Server sa.Enum se
+    materializa como VARCHAR + CHECK constraint, y el CHECK hay que
+    recrearlo.
+    """
+
+    reasignacion_solicitada = "reasignacion_solicitada"
+    reasignacion_aceptada = "reasignacion_aceptada"
+    reasignacion_rechazada = "reasignacion_rechazada"
+    reasignacion_expirada = "reasignacion_expirada"
+
+
 class Idea(Base):
     __tablename__ = "ideas"
 
@@ -130,3 +151,49 @@ class PreguntaIdea(Base):
 
     idea: Mapped["Idea"] = relationship()
     preguntada_por: Mapped["Usuario"] = relationship()
+
+
+class HistorialIdea(Base):
+    """Bitácora append-only y tipada de eventos sobre una idea.
+
+    Pensada como la línea de tiempo unificada a futuro, no como una tabla
+    exclusiva de reasignaciones: por eso el FK es a `ideas.id` y no a
+    `revision_ideas.id`, y por eso el evento se describe con un enum
+    (`tipo_evento`) en vez de con columnas específicas de un caso.
+
+    Vive en ideas/ y no en revision/ justamente por eso — revision ya
+    importa de ideas, y ponerla al revés obligaría a que ideas importara de
+    revision para construir la línea de tiempo.
+
+    Reemplaza conceptualmente a revision.models:HistorialReasignacion, que
+    queda de solo lectura tras el backfill (ver migración c9f3e820d114) y no
+    debe recibir filas nuevas.
+
+    Distinción importante entre las dos personas del evento:
+      - `actor_id`  = quién EJECUTÓ la acción (quién reasignó, quién aceptó).
+      - `sujeto_id` = a quién AFECTA (el revisor propuesto).
+    HistorialReasignacion guardaba `revisor_anterior_id`, que no es lo mismo
+    que el actor: un admin puede reasignar una idea que no es suya
+    (revision/router.py:_validar_revisor_asignado lo permite), y en ese caso
+    el revisor anterior no fue quien ejecutó nada.
+    """
+
+    __tablename__ = "historial_idea"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True)
+    idea_id: Mapped[int] = mapped_column(ForeignKey("ideas.id"), nullable=False, index=True)
+    tipo_evento: Mapped[TipoEventoIdea] = mapped_column(
+        Enum(TipoEventoIdea, name="tipo_evento_idea"), nullable=False
+    )
+    actor_id: Mapped[int] = mapped_column(ForeignKey("usuarios.id"), nullable=False)
+    sujeto_id: Mapped[int | None] = mapped_column(ForeignKey("usuarios.id"), nullable=True)
+    # Texto libre del evento: motivo de rechazo, comentario de la
+    # reasignación. NULL cuando el evento no lleva explicación.
+    detalle: Mapped[str | None] = mapped_column(Unicode(), nullable=True)
+    creado_en: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), server_default=func.now(), nullable=False
+    )
+
+    idea: Mapped["Idea"] = relationship()
+    actor: Mapped["Usuario"] = relationship(foreign_keys=[actor_id])
+    sujeto: Mapped["Usuario | None"] = relationship(foreign_keys=[sujeto_id])
