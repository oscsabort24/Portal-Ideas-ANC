+        foreign_keys=[reasignacion_solicitada_por_id]
+    )
+    fecha_solicitud_reasignacion: Mapped[datetime | None] = mapped_column(
+        DateTime(timezone=True), nullable=True
+    )
+
+    # Rechazos CONSECUTIVOS de propuestas sobre esta revisión. Se guarda como
